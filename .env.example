# ============================================
# 🤖 BOT TRADING MULTI-PAR - CONFIGURACIÓN
# ============================================

# 🔐 CREDENCIALES BINGX
BINGX_API_KEY=tu_api_key_aqui
BINGX_API_SECRET=tu_api_secret_aqui

# 📱 CREDENCIALES TELEGRAM
TELEGRAM_BOT_TOKEN=tu_bot_token_aqui
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# ================================================
# 📊 CONFIGURACIÓN DE TRADING - PERFIL MODERADO
# ================================================

# Pares a analizar (separados por coma)
# Opciones: Ver TRADING_PAIRS.md para lista completa
SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,ADA-USDT,AVAX-USDT,MATIC-USDT,LINK-USDT,DOT-USDT

# Timeframe para análisis
# Opciones: 1m, 5m, 15m, 1h, 4h, 1d
TIMEFRAME=15m

# Intervalo de chequeo en segundos
CHECK_INTERVAL=60

# Tamaño máximo por posición en USDT
MAX_POSITION_SIZE=100

# Máximo de posiciones simultáneas
MAX_POSITIONS=3

# ================================================
# ⚙️ PARÁMETROS DE ESTRATEGIA
# ================================================

# Linear Regression - Período
LINREG_LENGTH=50

# Linear Regression - Multiplicador de desviación
LINREG_MULT=2.2

# ADX - Umbral de fuerza de tendencia
ADX_THRESHOLD=25

# Ratio Riesgo:Beneficio
RISK_REWARD=2.5

# ================================================
# 📝 NOTAS DE CONFIGURACIÓN
# ================================================

# PERFIL CONSERVADOR (Principiantes)
# SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT
# MAX_POSITION_SIZE=50
# MAX_POSITIONS=2
# TIMEFRAME=1h

# PERFIL MODERADO (Intermedios) - ACTUAL
# SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,ADA-USDT,AVAX-USDT,MATIC-USDT,LINK-USDT,DOT-USDT
# MAX_POSITION_SIZE=100
# MAX_POSITIONS=3
# TIMEFRAME=15m

# PERFIL AGRESIVO (Avanzados)
# SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT,BNB-USDT,XRP-USDT,ADA-USDT,DOGE-USDT,AVAX-USDT,DOT-USDT,MATIC-USDT,LINK-USDT,UNI-USDT,ATOM-USDT,ARB-USDT,OP-USDT
# MAX_POSITION_SIZE=150
# MAX_POSITIONS=5
# TIMEFRAME=5m

# ================================================
# 🎯 CÓMO OBTENER CREDENCIALES
# ================================================

# BingX API:
# 1. Ve a https://bingx.com
# 2. Login en tu cuenta
# 3. Account → API Management
# 4. Create New API Key
# 5. Copia API Key y Secret

# Telegram Bot:
# 1. Abre Telegram y busca @BotFather
# 2. Envía /newbot y sigue instrucciones
# 3. Copia el Bot Token que te proporciona
# 4. Busca @userinfobot para obtener tu Chat ID
