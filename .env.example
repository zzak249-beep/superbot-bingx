# ══════════════════════════════════════════════════════
# BOT FLOOP Pro v4.0 — Variables Railway
# ══════════════════════════════════════════════════════

# BingX API
BINGX_API_KEY=tu_api_key
BINGX_API_SECRET=tu_api_secret

# Telegram
TELEGRAM_BOT_TOKEN=tu_token
TELEGRAM_CHAT_ID=tu_chat_id

# Trading
AUTO_TRADING_ENABLED=true
LEVERAGE=3
MAX_OPEN_TRADES=3

# MEJORA 1: Tamaño dinámico por % del balance
RISK_PCT_PER_TRADE=15
MIN_TRADE_USDT=7
MAX_TRADE_USDT=20

# TP/SL ATR dinámico
TP_ATR_MULT=3.0
SL_ATR_MULT=2.2
TP_MIN_PCT=1.5
TP_MAX_PCT=6.0
SL_MIN_PCT=0.8
SL_MAX_PCT=2.5

# MEJORA 5: Score alto
MIN_SCORE=10

# MEJORA 6: Cooldowns largos
COOLDOWN_AFTER_TP_MIN=20
COOLDOWN_AFTER_SL_MIN=45

# MEJORA 7: Trailing mejorado
TRAILING_STOP_ENABLED=true
TRAILING_ACTIVATE_PCT=1.0
TRAILING_PROTECT_PCT=70
BREAKEVEN_PCT=0.5

# Filtros
MIN_VOLUME_24H=500000
MAX_SYMBOLS_TO_ANALYZE=60
CHECK_INTERVAL=120
USE_LIMIT_ORDERS=true
ENABLE_LONGS=true
ENABLE_SHORTS=true

# Filtro BTC dual
BTC_FILTER_1H_PCT=1.5
BTC_FILTER_4H_PCT=2.5

# Filtro mercado
MARKET_FILTER_ENABLED=true
MARKET_FILTER_PCT=2.0
MARKET_FILTER_MIN_BAD=3

# FLOOP Core
FLOOP_SENSITIVITY=6
FLOOP_ATR_LENGTH=14
FLOOP_ATR_MULT=0.8
FLOOP_EMA_FAST=60
FLOOP_EMA_SLOW=200
FLOOP_EMA_FILTER=true
FLOOP_HTF_TF=1h
FLOOP_ADX_FILTER=true
FLOOP_ADX_LENGTH=14
FLOOP_ADX_THRESH=20
FLOOP_CHOP_FILTER=true
FLOOP_CHOP_LENGTH=14
FLOOP_CHOP_THRESH=61.8
FLOOP_COOLDOWN_BARS=5
