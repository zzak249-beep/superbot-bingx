# ══════════════════════════════════════════════
#  QF×JP Bot v3 — Variables de entorno Railway
# ══════════════════════════════════════════════

# ── BingX API ─────────────────────────────────
BINGX_API_KEY=TU_API_KEY_AQUI
BINGX_SECRET_KEY=TU_SECRET_KEY_AQUI

# ── Telegram ──────────────────────────────────
TELEGRAM_TOKEN=TU_BOT_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# ── Operativa ─────────────────────────────────
SYMBOL=BTC-USDT
LEVERAGE=10
RISK_PER_TRADE=0.015
MAX_POSITIONS=2
DAILY_LOSS_LIMIT=0.06

# ── SL / TP ───────────────────────────────────
SL_ATR_MULT=1.5
TP_RR_STD=2.0
TP_RR_FUEL=2.5
TP_RR_SUP=3.0
TRAIL_ATR_MULT=1.0

# ── Filtros ───────────────────────────────────
MIN_CONVICTION=5
MAX_FUNDING_LONG=0.0010
MIN_FUNDING_SHORT=-0.0010
COOLDOWN_CANDLES=3

# ── Multi-par (opcional) ──────────────────────
# Ponlo en true para escanear los top N pares
MULTI_PAIR=false
TOP_PAIRS=30
MIN_VOLUME_USDT=5000000

# ── Railway ───────────────────────────────────
PORT=8080
