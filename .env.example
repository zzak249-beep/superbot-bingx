# ══════════════════════════════════════════════════════════════
# BOT FLOOP Pro v3 — Variables de Entorno
# ══════════════════════════════════════════════════════════════

# ── CREDENCIALES ──────────────────────────────────────────────
BINGX_API_KEY=TU_API_KEY_AQUI
BINGX_API_SECRET=TU_API_SECRET_AQUI
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# ── MODO ──────────────────────────────────────────────────────
# false = solo manda senales por Telegram, NO abre trades reales
AUTO_TRADING_ENABLED=true

# ── CAPITAL ───────────────────────────────────────────────────
MAX_POSITION_SIZE=7        # USDT de margen por trade
MIN_TRADE_USDT=5           # Minimo de orden
LEVERAGE=3                 # Apalancamiento (3x recomendado para empezar)
MAX_OPEN_TRADES=3          # Maximos simultaneos

# ── CICLO ─────────────────────────────────────────────────────
CHECK_INTERVAL=120         # Segundos entre ciclos (120 = 2 min)
MIN_VOLUME_24H=500000      # Volumen minimo del par en USDT
MAX_SYMBOLS_TO_ANALYZE=60  # Pares a analizar por ciclo

# ── DIRECCIONES ───────────────────────────────────────────────
ENABLE_LONGS=true
ENABLE_SHORTS=true

# ── FILTRO BTC v3 (corregido) ─────────────────────────────────
# Antes solo miraba 1 vela de 1h — ahora mira ventanas reales.
# Para abrir un LONG se requiere AMBAS condiciones:
#   BTC en las ultimas 4 velas de 15m (=1h real) > -BTC_FILTER_1H_PCT
#   BTC en las ultimas 4 velas de 1h  (=4h real) > -BTC_FILTER_4H_PCT
# Ejemplo: ese dia DOGE abrio LONG con BTC +0.19% en 1h (v2 lo paso)
# pero BTC habia caido -2.7% en 4h real => v3 lo habria bloqueado

BTC_FILTER_1H_PCT=1.5      # Bloquea LONGS si BTC cae mas de 1.5% en 1h real
BTC_FILTER_4H_PCT=2.5      # Bloquea LONGS si BTC cae mas de 2.5% en 4h real
                            # (Idem inverso para SHORTS)

# ── FILTRO DE MERCADO AMPLIO v3 (nuevo) ───────────────────────
# Comprueba los 5 pares principales (BTC/ETH/SOL/BNB/XRP).
# Si 3 o mas caen mas de MARKET_FILTER_PCT% en 1h => no abre LONGS.
# Si 3 o mas suben mas de MARKET_FILTER_PCT% en 1h => no abre SHORTS.
# Esto habria bloqueado el DOGE ese dia (BTC -4%, DOGE -3.8%, AVAX -3.3%).

MARKET_FILTER_ENABLED=true
MARKET_FILTER_PCT=2.0      # % de caida en 1h para considerar un par "bajista"
MARKET_FILTER_MIN_BAD=3    # Cuantos pares del top-5 deben caer para bloquear

# ── TP/SL ATR ─────────────────────────────────────────────────
TP_ATR_MULT=3.0            # TP = ATR x 3.0 (NQ 5m setting de FLOOP)
SL_ATR_MULT=2.2            # SL = ATR x 2.2
TP_MIN_PCT=1.2
TP_MAX_PCT=6.0
SL_MIN_PCT=0.8
SL_MAX_PCT=3.0

# ── SCORE ─────────────────────────────────────────────────────
MIN_SCORE=8                # 8=MED, 11=HIGH conviction

# ── COOLDOWN (diferenciado TP vs SL) ──────────────────────────
# Despues de un TP espera 15min antes de re-entrar en ese par.
# Despues de un SL espera 30min (evita revenge trades como DOGE).
COOLDOWN_AFTER_TP_MIN=15
COOLDOWN_AFTER_SL_MIN=30

# ── ORDENES ───────────────────────────────────────────────────
USE_LIMIT_ORDERS=true      # true = maker (0.02%)  false = taker (0.05%)
TRAILING_STOP_ENABLED=true

# ── FLOOP CORE ────────────────────────────────────────────────
FLOOP_SENSITIVITY=6        # 1-30. 6=default, 12=mas estricto
FLOOP_ATR_LENGTH=14
FLOOP_ATR_MULT=0.8
FLOOP_EMA_FAST=60
FLOOP_EMA_SLOW=200
FLOOP_EMA_FILTER=true      # ON = exige EMA alineada (ML recomienda +27% WR)
FLOOP_HTF_TF=1h
FLOOP_ADX_FILTER=true
FLOOP_ADX_THRESH=20        # 20=moderado, 25=estricto
FLOOP_CHOP_FILTER=true
FLOOP_CHOP_THRESH=61.8
FLOOP_COOLDOWN_BARS=5
