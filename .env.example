# ═══════════════════════════════════════════════════════════════
# BingX Signal Bot v7 — VARIABLES DE ENTORNO OPTIMIZADAS
# ═══════════════════════════════════════════════════════════════
# Copia este archivo y configura tus valores reales en Railway.
# NUNCA subas las API keys a Git.

# ── API Keys (obligatorio) ──────────────────────────────────── #
BINGX_API_KEY=tu_api_key_aqui
BINGX_API_SECRET=tu_api_secret_aqui

# ── Telegram (opcional pero recomendado) ───────────────────────#
TELEGRAM_TOKEN=tu_bot_token
TELEGRAM_CHAT_ID=tu_chat_id

# ── Modo de operación ──────────────────────────────────────────#
# FASE 1 (primeras 2 semanas): DRY_RUN=true
# FASE 2 (con historial validado): DRY_RUN=false
DRY_RUN=true
AUTO_TRADING_ENABLED=true

# ── Capital y riesgo ───────────────────────────────────────────#
ACCOUNT_EQUITY=100          # Tu capital real en futuros USDT
MAX_POSITION_SIZE=12        # Máximo por trade en USDT
MIN_TRADE_USDT=10           # Mínimo operación
RISK_PCT=0.01               # 1% del capital en riesgo por trade
MAX_OPEN_TRADES=3           # Máximo posiciones simultáneas
MAX_DAILY_TRADES=6          # Máximo trades por día
DAILY_LOSS_CAP_PCT=6.0      # Parar si perdemos 6% en el día
MAX_LOSING_STREAK=3         # Parar tras 3 pérdidas seguidas

# ── Apalancamiento dinámico ────────────────────────────────────#
# El bot ajusta automáticamente según la coin y su volatilidad
LEV_MAJOR=5                 # BTC, ETH, BNB, SOL, XRP
LEV_MID=3                   # Top-50 altcoins conocidas
LEV_SMALL=2                 # Micro-caps y altcoins pequeñas
# (El ATR reduce el leverage automáticamente si volatilidad alta)

# ── Targets y stops ────────────────────────────────────────────#
TP1_RATIO=2.5               # TP1 = entry + SL_dist × 2.5
TP2_RATIO=4.0               # TP2 = entry + SL_dist × 4.0
TP1_PCT=40                  # Cerrar 40% de la posición en TP1
TP2_PCT=35                  # Cerrar 35% en TP2
SL_MULT=1.0                 # Multiplicador del ATR para el SL
SL_MAX_PCT=2.5              # SL máximo en % del precio
SL_MIN_PCT=0.5              # SL mínimo en %
MIN_RR=2.5                  # Risk/Reward mínimo requerido

# ── Trailing stop ──────────────────────────────────────────────#
USE_TRAILING_EXIT=true
TRAIL_RATE_PCT=1.2          # Trailer sigue al precio -1.2%
TRAIL_ACTIVATION=1.0        # Activar cuando ganamos 1%+

# ── Tiempo máximo por trade ────────────────────────────────────#
MAX_HOLD_HOURS=48           # Cerrar si lleva 48h sin TP/SL

# ── Scoring y filtros de calidad ───────────────────────────────#
MIN_SCORE=60                # Mínimo score para evaluar señal (motor)
MIN_SIGNAL_SCORE=60         # Mínimo score para abrir trade (coherente!)
SCORE_BULL=75               # Score "mercado alcista"
MTF_MIN_CONFLUENCE=25       # Mínimo puntos MTF para contar

# ── Scanner de mercado ─────────────────────────────────────────#
TOP_SYMBOLS=40              # Analizar top 40 coins calientes
MAX_SYMBOLS=150             # Máximo coins en universo inicial
MIN_VOLUME_USDT=500000      # Volumen 24h mínimo en USDT
MIN_VOLUME_24H=800000       # Volumen 24h para scanner
MOMENTUM_MIN=0.8            # Mínimo % de momentum
VOL_SPIKE_MIN=1.5           # Mínimo multiplicador de volumen
SCAN_INTERVAL_SEC=30        # Ciclo del bot en segundos

# ── Indicadores técnicos ───────────────────────────────────────#
KLINE_INTERVAL=1h           # Timeframe principal
BB_PERIOD=20                # Periodo Bollinger Bands
BB_STD=2.0                  # Desviaciones estándar BB
RSI_PERIOD=14               # Periodo RSI

# ── Sesiones de trading ────────────────────────────────────────#
SESSION_FILTER=true         # Preferir London/NY
SESSION_LONDON_S=7
SESSION_LONDON_E=12
SESSION_NY_S=13
SESSION_NY_E=17

# ── Cooldowns (evitar re-entradas prematuras) ──────────────────#
COOLDOWN_TP_MIN=15          # 15 min cooldown tras TP
COOLDOWN_SL_MIN=240         # 4h cooldown tras SL (240 min)

# ── Circuit breaker ────────────────────────────────────────────#
CIRCUIT_BREAKER_PCT=5.0     # Parar si perdemos 5% del equity
CB_PAUSE_HOURS=4            # Horas parado tras circuit breaker

# ── Filtros macro ──────────────────────────────────────────────#
BTC_BLOCK_PCT=0.4           # Bloquear si BTC cae >0.4% en 1h
SCANNER_MIN_CONFIDENCE=50   # Mínimo confianza del scanner

# ── Railway deployment ─────────────────────────────────────────#
PORT=8080
