# ══════════════════════════════════════════════════════
# BOT SHORTS v3.4 — Variables Railway LIMPIAS
# ══════════════════════════════════════════════════════

# BingX API
BINGX_API_KEY=""
BINGX_API_SECRET=""

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Trading general ---
AUTO_TRADING_ENABLED="true"
MAX_OPEN_TRADES="2"
MAX_POSITION_SIZE="10"
MIN_TRADE_USDT="10"
FORCE_MIN_USDT="10.0"
LEVERAGE="3"
CHECK_INTERVAL="60"

# --- Scoring ---
MIN_SCORE="82"

# --- TP / SL ---
TAKE_PROFIT_PCT="2.5"
STOP_LOSS_PCT="1.5"

# --- Trailing Stop ---
TRAILING_STOP_ENABLED="true"
TRAILING_START_PCT="1.0"
TRAILING_LOCK_PCT="60"

# --- Protección de pérdidas ---
MAX_LOSS_PCT="5.0"

# --- Cooldowns ---
COOLDOWN_AFTER_TP_MIN="15"
COOLDOWN_AFTER_SL_MIN="45"

# --- Filtros de mercado ---
MIN_VOLUME_24H="500000"
MAX_SYMBOLS_TO_ANALYZE="50"
BTC_BULL_BLOCK_PCT="1.5"

# --- Órdenes ---
USE_LIMIT_ORDERS="true"
SL_LIMIT_OFFSET_PCT="0.05"

# --- MAE / Patrones ---
MAE_PERIOD="20"
MAE_PCT="2.0"
PATTERN_SCORE="true"
REGIME_FILTER="true"
