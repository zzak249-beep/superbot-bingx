# ══════════════════════════════════════════════
# Conflux 4 Bot v2 — Variables de entorno
# Copia como .env — NUNCA subas .env a GitHub
# ══════════════════════════════════════════════

# ── OBLIGATORIO ───────────────────────────────
TELEGRAM_TOKEN=7123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# ── BingX ─────────────────────────────────────
BINGX_API_KEY=
BINGX_SECRET=
BINGX_TESTNET=true          # EMPIEZA SIEMPRE CON true

# ── AUTO TRADE ────────────────────────────────
AUTO_TRADE=false             # false = solo señales en Telegram
# Pon true solo cuando hayas validado las señales manualmente durante 2+ semanas

# ── Pares (formato BingX futuros) ─────────────
SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT

# ── Timeframe principal ───────────────────────
INTERVAL=15m                 # MTF se calcula automáticamente (1h + 4h)

# ── Preset ────────────────────────────────────
PRESET=Daytrader             # Scalp | Daytrader | Swing

# ── Escaneo ───────────────────────────────────
SCAN_SECONDS=60

# ── Capital y riesgo ──────────────────────────
STARTING_BALANCE=1000        # Tu capital en USDT
MAX_DAILY_LOSS_PCT=3.0       # Detiene el bot si pierde este % en un día
MAX_DRAWDOWN_PCT=15.0        # Detiene el bot si el drawdown supera este %
