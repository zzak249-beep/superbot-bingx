# ══════════════════════════════════════════════════
#  BingX Trading Bot — Variables de Entorno
#  Copia este archivo a .env y rellena los valores
# ══════════════════════════════════════════════════

# ─── BingX API ────────────────────────────────────
# Obtén tus claves en: BingX → Perfil → Gestión API
BINGX_API_KEY=tu_api_key_aqui
BINGX_SECRET_KEY=tu_secret_key_aqui

# DEMO_MODE=true  → Solo simula, NO envía órdenes reales
# DEMO_MODE=false → Modo real (¡usa con cuidado!)
DEMO_MODE=true

# ─── Configuración de Trading ─────────────────────
LEVERAGE=5                    # Apalancamiento (5x recomendado)
MAX_OPEN_POSITIONS=5          # Máximo de posiciones simultáneas
MAX_RISK_PER_TRADE=1.5        # % del balance arriesgado por trade
MAX_DAILY_LOSS_PCT=5.0        # % pérdida diaria máxima antes de parar
MIN_SCORE=55.0                # Score mínimo de señal (0-100)
TRADE_INTERVAL=15m            # Timeframe: 1m,5m,15m,30m,1h,4h
LOOP_SLEEP_SECONDS=60         # Segundos entre cada ciclo del bot

# ─── Signal Engine (Signal Projection Explorer) ───
FAST_MA=50                    # Media móvil rápida
SLOW_MA=200                   # Media móvil lenta
PROJ_LENGTH=10                # Longitud de proyección
ADX_LEN=14                    # Período ADX
ADX_MIN=20.0                  # ADX mínimo para señal
ATR_LEN=14                    # Período ATR
ATR_MA_LEN=50                 # Media del ATR
ATR_MULT=1.0                  # Multiplicador ATR vs su media
RSI_LEN=14                    # Período RSI
RSI_LONG_MIN=52.0             # RSI mínimo para longs
RSI_SHORT_MAX=48.0            # RSI máximo para shorts
EMA_TREND=200                 # EMA de tendencia

# ─── Scanner de Monedas Explosivas ────────────────
MIN_VOLUME_24H=500000         # Volumen mínimo 24h en USD
MAX_COINS_SCAN=15             # Máximo de monedas a analizar
VOL_SPIKE_MIN=2.0             # Spike de volumen mínimo (2x = 200%)
MIN_CHANGE_ABS=2.0            # Cambio mínimo 24h en %
SCAN_INTERVAL_MIN=15          # Cada cuántos minutos re-escanear
CANDLES=300                   # Velas históricas a descargar

# ─── Bot v2: Funding + OI ─────────────────────────────
FUNDING_BLOCK=0.0005          # Funding rate que bloquea longs (0.05%)
FUNDING_BLOCK_SHORT=-0.0005   # Funding rate que bloquea shorts (-0.05%)
REQUIRE_OI_CONFIRM=true       # Exigir OI creciente para confirmar señal

# ─── Bot v2: Multi-Timeframe ──────────────────────────
MTF_MIN_CONFLUENCE=25.0       # Score confluencia mínimo (-100 a +100)
MTF_CHECK_1H=true             # Activar filtro 1h
MTF_CHECK_4H=true             # Activar filtro 4h

# ─── Bot v2: Smart Limit Orders ──────────────────────
LIMIT_ATR_OFFSET=0.3          # Offset de entrada = ATR × 0.3
LIMIT_WAIT_SECONDS=45         # Espera máxima por el límite antes de market

# ─── Bot v2: Correlation Filter ──────────────────────
MAX_CORRELATION=0.80          # Correlación máxima entre posiciones abiertas

# ─── Bot v2: Session Filter ───────────────────────────
SESSION_FILTER=false          # Subir umbral en sesión Asia (00-07 UTC)

# ─── Telegram (opcional pero recomendado) ─────────────
# Obtén el token en @BotFather de Telegram
# Obtén tu chat_id en @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
