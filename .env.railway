# ============================================
# 🚀 BOT TRADING - CONFIGURACIÓN RAILWAY
# MÁXIMO RENDIMIENTO - TODOS LOS PARES
# ============================================

# 🔐 CREDENCIALES BINGX (REQUERIDO)
BINGX_API_KEY=tu_api_key_real_aqui
BINGX_API_SECRET=tu_api_secret_real_aqui

# 📱 CREDENCIALES TELEGRAM (REQUERIDO)
TELEGRAM_BOT_TOKEN=tu_bot_token_real_aqui
TELEGRAM_CHAT_ID=tu_chat_id_real_aqui

# ================================================
# 📊 PARES A ANALIZAR - MÁXIMA DIVERSIFICACIÓN
# ================================================
# 60+ PARES CUBIERTOS - Todos los principales + altcoins

SYMBOLS=BTC-USDT,ETH-USDT,BNB-USDT,SOL-USDT,XRP-USDT,ADA-USDT,DOGE-USDT,AVAX-USDT,DOT-USDT,MATIC-USDT,LINK-USDT,UNI-USDT,ATOM-USDT,LTC-USDT,ETC-USDT,ARB-USDT,OP-USDT,APT-USDT,SUI-USDT,SEI-USDT,TIA-USDT,INJ-USDT,AAVE-USDT,MKR-USDT,CRV-USDT,COMP-USDT,SNX-USDT,SUSHI-USDT,AXS-USDT,SAND-USDT,MANA-USDT,GALA-USDT,IMX-USDT,FTM-USDT,NEAR-USDT,ALGO-USDT,ONE-USDT,CELO-USDT,SHIB-USDT,PEPE-USDT,FLOKI-USDT,BONK-USDT,WIF-USDT,JTO-USDT,WLD-USDT,ME-USDT,ONDO-USDT,ENA-USDT,PENDLE-USDT,ENS-USDT,GRT-USDT,STRK-USDT,BLUR-USDT,LDO-USDT,LIDO-USDT,STETH-USDT,RETH-USDT,XEC-USDT,ICP-USDT

# ================================================
# ⏱️ CONFIGURACIÓN DE TIMING Y ANÁLISIS
# ================================================

# Marco temporal - 15 minutos = balance entre velocidad y calidad
TIMEFRAME=15m

# Intervalo de chequeo en segundos - 60s = verifica cada minuto
CHECK_INTERVAL=60

# ================================================
# 💰 GESTIÓN DE POSICIONES
# ================================================

# Tamaño MÁXIMO por posición en USDT
# 100 = máximo $100 por operación (2% de $5000)
MAX_POSITION_SIZE=100

# Máximo de posiciones SIMULTÁNEAS
# 8 = permite hasta 8 posiciones abiertas a la vez
# Con 60 pares analizados y solo los MEJORES seleccionados
MAX_POSITIONS=8

# ================================================
# ⚙️ PARÁMETROS DE ESTRATEGIA OPTIMIZADOS
# ================================================

# Linear Regression - Período de regresión (50 = óptimo para 15m)
LINREG_LENGTH=50

# Linear Regression - Multiplicador de desviación (2.2 = balance)
LINREG_MULT=2.2

# ADX - Umbral mínimo de fuerza de tendencia
# 25 = solo tendencias PROBADAS, evita mercados laterales
ADX_THRESHOLD=25

# Ratio Riesgo:Beneficio
# 2.5 = por cada $1 que arriesgamos, ganamos $2.50
RISK_REWARD=2.5

# ================================================
# 🎯 PARÁMETROS AVANZADOS (Opcional)
# ================================================

# EMA Fast - Para detección rápida de cambios
EMA_FAST=20

# EMA Slow - Para tendencia principal
EMA_SLOW=50

# EMA Trend - Para régimen de mercado (200 períodos)
EMA_TREND=200

# Período RSI (14 = estándar)
RSI_PERIOD=14

# Período ATR (14 = estándar)
ATR_LENGTH=14

# Multiplicador ATR (2.0 = estándar)
ATR_MULT=2.0

# ================================================
# 🔔 NOTIFICACIONES Y LOGGING
# ================================================

# Enviar notificación en cada análisis (true/false)
# false = solo notificaciones de trades
LOG_EVERY_ANALYSIS=false

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ================================================
# 📈 ESTADÍSTICAS Y REPORTES
# ================================================

# Enviar reporte semanal de PnL (true/false)
WEEKLY_REPORT=true

# Enviar reporte diario de trades (true/false)
DAILY_REPORT=true

# ================================================
# 🔒 CONFIGURACIÓN AVANZADA
# ================================================

# Timeout para requests (segundos)
API_TIMEOUT=10

# Reintentos en caso de error
API_RETRIES=3

# Delay entre reintentos (segundos)
RETRY_DELAY=5

# ================================================
# 📝 NOTAS SOBRE ESTA CONFIGURACIÓN
# ================================================

# SÍMBOLOS CUBIERTOS (60+ PARES):
# ========================
# TOP 5: BTC, ETH, BNB, SOL, XRP
# ALTCOINS TOP 20: ADA, DOGE, AVAX, DOT, MATIC, LINK, UNI, ATOM, LTC, ETC, ARB, OP, APT, SUI, SEI, TIA, INJ, AAVE, MKR, CRV
# DEFI: COMP, SNX, SUSHI, UNI, AAVE, MKR, CRV, GRT, LDO
# GAMING/METAVERSE: AXS, SAND, MANA, GALA, IMX, BLUR
# LAYER1/2: FTM, NEAR, ALGO, ONE, CELO, STETH, RETH
# MEMECOINS: SHIB, PEPE, FLOKI, BONK, WIF, DOGE
# NUEVOS: JTO, WLD, ME, ONDO, PENDLE, BLUR, ENA, STRK, ENS, ICP

# ========================
# RENTABILIDAD ESPERADA
# ========================
# Con 60+ pares y solo señales de alta calidad:
# - Operaciones/mes: 80-150 (muchas oportunidades)
# - Win rate: 60-65% (filtros ultra-estrictos)
# - Retorno mensual: 15-25% en perfil moderado
# - Máximo capital recomendado: $5000+
# - Riesgo por operación: 2% ($100 de $5000)

# ========================
# VENTAJAS DE ESTA CONFIGURACIÓN
# ========================
# ✅ 60+ pares = máximas oportunidades
# ✅ TIMEFRAME 15m = balance velocidad/calidad
# ✅ MAX_POSITIONS 8 = diversificación óptima
# ✅ CHECK_INTERVAL 60s = análisis rápido
# ✅ ADX > 25 = solo tendencias probadas
# ✅ Análisis PARALELO = 10x más rápido

# ========================
# CÓMO USAR EN RAILWAY
# ========================
# 1. Ve a tu proyecto en railway.app
# 2. Variables → Add Variable
# 3. Copia CADA línea (nombre=valor)
# 4. Ejemplo:
#    BINGX_API_KEY = abc123def456...
#    BINGX_API_SECRET = xyz789...
#    etc.
# 5. Deploy / Redeploy
# 6. Bot inicia automáticamente 24/7

# ========================
# MONITOREO EN RAILWAY
# ========================
# 1. Deployments → Ver logs
# 2. Verás:
#    ✅ Bot inicializado
#    📊 Analizando 60+ pares
#    🟢 LONG abierto
#    🔴 SHORT abierto
#    🔒 Posición cerrada
#    ⚠️ Errores (si los hay)

