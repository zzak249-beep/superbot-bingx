# ══════════════════════════════════════════════════════════════
# FLOOP Pro v3 — Variables corregidas
# ══════════════════════════════════════════════════════════════

# ── CREDENCIALES ──────────────────────────────────────────────
BINGX_API_KEY=TU_API_KEY
BINGX_API_SECRET=TU_API_SECRET
TELEGRAM_BOT_TOKEN=TU_TOKEN
TELEGRAM_CHAT_ID=TU_CHAT_ID

# ── MODO ──────────────────────────────────────────────────────
AUTO_TRADING_ENABLED=true

# ── CAPITAL ───────────────────────────────────────────────────
MAX_POSITION_SIZE=7
MIN_TRADE_USDT=5
LEVERAGE=3
MAX_OPEN_TRADES=4
CHECK_INTERVAL=180

# ── PARES ─────────────────────────────────────────────────────
MIN_VOLUME_24H=5000000
MAX_SYMBOLS_TO_ANALYZE=50

# ── SCORE — CAUSA RAIZ DEL PROBLEMA ──────────────────────────
# FLOOP usa escala 0-14, NO 0-100
# Con MIN_SCORE=80 el bot NUNCA puede dar señales (maximo es 14)
# 8  = MED (señales moderadas, mas trades)
# 11 = HIGH (señales de alta conviccion, menos trades pero mejores)
MIN_SCORE=8

# ── DIRECCIONES ───────────────────────────────────────────────
ENABLE_LONGS=true
# CORRECTO: la variable se llama ENABLE_SHORTS, no ENABLE_SHORT_TRADES
ENABLE_SHORTS=false

# ── TP/SL ─────────────────────────────────────────────────────
# CORRECTO: el bot FLOOP usa TP_ATR_MULT, no TAKE_PROFIT_PCT
TP_ATR_MULT=3.0
SL_ATR_MULT=2.2
TP_MIN_PCT=1.2
TP_MAX_PCT=6.0
SL_MIN_PCT=0.8
SL_MAX_PCT=3.0

# ── ORDENES ───────────────────────────────────────────────────
USE_LIMIT_ORDERS=true
TRAILING_STOP_ENABLED=true

# ── FILTRO BTC (doble ventana real) ───────────────────────────
# CORRECTO: BTC_FILTER_1H_PCT y BTC_FILTER_4H_PCT (no BTC_BEAR_BLOCK_PCT)
BTC_FILTER_1H_PCT=1.5
BTC_FILTER_4H_PCT=2.5

# ── FILTRO MERCADO AMPLIO ─────────────────────────────────────
MARKET_FILTER_ENABLED=true
MARKET_FILTER_PCT=2.0
MARKET_FILTER_MIN_BAD=3

# ── COOLDOWN ──────────────────────────────────────────────────
COOLDOWN_AFTER_TP_MIN=15
COOLDOWN_AFTER_SL_MIN=30

# ── FLOOP CORE ────────────────────────────────────────────────
FLOOP_SENSITIVITY=6
FLOOP_ATR_LENGTH=14
FLOOP_ATR_MULT=0.8
FLOOP_EMA_FAST=60
FLOOP_EMA_SLOW=200
FLOOP_EMA_FILTER=true
FLOOP_HTF_TF=1h
FLOOP_ADX_FILTER=true
FLOOP_ADX_THRESH=20
FLOOP_CHOP_FILTER=true
FLOOP_CHOP_THRESH=61.8
FLOOP_COOLDOWN_BARS=5
SL_LIMIT_OFFSET_PCT=0.05
