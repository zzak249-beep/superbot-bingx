# ═══════════════════════════════════════════
# SMC SNIPER BOT — Railway Variables
# Copia esto en Railway → Variables
# ═══════════════════════════════════════════

BINGX_API_KEY=PON_TU_API_KEY_AQUI
BINGX_SECRET_KEY=PON_TU_SECRET_KEY_AQUI
BINGX_MODE=hedge

TELEGRAM_TOKEN=PON_TU_BOT_TOKEN
TELEGRAM_CHAT_ID=PON_TU_CHAT_ID

MEMORY_DIR=/app/data
MODO_DEMO=false

TIMEFRAME=5m
PIVOT_LEN=15
QML_ZIGZAG=13
QML_MIN_ATR=1.5
CLUSTER_BARS=20
VOL_MULT=1.3

SL_ATR_MULT=1.5
TP_DIST_MULT=3.0
TP1_DIST_MULT=1.5
MIN_RR=2.0

TRADE_USDT_BASE=10
TRADE_USDT_MAX=100
LEVERAGE=10
MAX_POSICIONES=3
MAX_PERDIDA_DIA=30
TIME_EXIT_HORAS=8

COMPOUND_STEP_USDT=50
COMPOUND_ADD_USDT=5

TRAILING_ACTIVO=true
TRAILING_ACTIVAR=1.5
TRAILING_DISTANCIA=1.0
PARTIAL_TP_ACTIVO=true
BE_ACTIVO=true
COOLDOWN_VELAS=5

MAX_PARES_SCAN=30
VOLUMEN_MIN_24H=10000000
SOLO_LONG=false

LOOP_SECONDS=90
ANALISIS_WORKERS=4

VERSION=SMC Sniper Bot v1.0
LOG_LEVEL=INFO

# ── Delta Strike 量能猎杀 ────────────────────────────
DS_VOL_SHORT=20
DS_VOL_MID=60
DS_VOL_LONG=180
DS_RATIO_SHORT=1.5
DS_RATIO_MID=3.0
DS_RATIO_LONG=5.0
DS_RSI_OB=60
DS_RSI_OS=40
DS_IMB_RATIO=2.0
DS_N_CONFIRM=5
