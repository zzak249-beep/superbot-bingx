# ════════════════════════════════════════════════
#  InstitutionalBot v6.0 — Variables para Railway
#  Copia todo esto en Railway → Variables
# ════════════════════════════════════════════════

# ── BingX ────────────────────────────────────────
BINGX_API_KEY=TU_API_KEY_AQUI
BINGX_API_SECRET=TU_API_SECRET_AQUI

# ── Telegram ─────────────────────────────────────
TELEGRAM_BOT_TOKEN=TU_BOT_TOKEN_AQUI
TELEGRAM_CHAT_ID=TU_CHAT_ID_AQUI

# ── Trade sizing ──────────────────────────────────
LEVERAGE=10
RISK_PCT=1.0              # % del balance por trade
MAX_OPEN_TRADES=6         # máximo trades simultáneos

# ── Scan ──────────────────────────────────────────
SCAN_INTERVAL_SEC=30      # cada 30s escanea (era 45s)
MAX_SYMBOLS=150           # símbolos analizados (era 100)
MIN_VOLUME_USDT=500000    # volumen mínimo 24h ($500k)

# ── Volume Profile ────────────────────────────────
VP_BINS=20                # ← CRÍTICO: no subir de 30
HVN_THRESHOLD_PCT=4.0
VP_LOOKBACK=150

# ── Señales ───────────────────────────────────────
MIN_SCORE_LONG=3.0        # score mínimo para LONG
MIN_SCORE_SHORT=3.0       # score mínimo para SHORT
ENABLE_SHORTS=true        # ← NUEVO: habilita shorts
MIN_ATR_PCT=0.5           # volatilidad mínima (evita monedas planas)

# ── TP / SL ───────────────────────────────────────
SL_ATR_MULT=1.5
TP1_ATR_MULT=2.0
TP2_ATR_MULT=4.0
TP3_ATR_MULT=7.0          # era 6.0, ahora más ambicioso

# ── Trailing Stop NATIVO BingX ────────────────────
TRAIL_PCT=1.5             # % trailing después de TP2
MEGA_TRAIL_PCT=3.0        # % trailing en Mega Runner (más amplio)

# ── Mega Runner ───────────────────────────────────
RUNNER_ENABLED=true
MEGA_RUNNER_TRIGGER=2.0   # activa cuando precio sube 2× dist_TP2 extra

# ── Gestión riesgo diaria ─────────────────────────
MAX_DAILY_LOSS_PCT=5.0    # pausa si pierde 5% del balance del día

# ── Timeframes ────────────────────────────────────
PRIMARY_TF=15m
HTF=1h

# ════════════════════════════════════════════════
#  RESUMEN DE CAMBIOS v5 → v6
# ════════════════════════════════════════════════
#
#  + ENABLE_SHORTS=true     → el doble de oportunidades
#  + SCAN_INTERVAL_SEC=30   → más rápido (era 45s)
#  + MAX_SYMBOLS=150         → más monedas (era 100)
#  + Trailing Stop NATIVO   → BingX gestiona el trail automáticamente
#  + ADX indicator          → filtra tendencias fuertes
#  + Donchian breakout      → señal extra muy potente
#  + MAX_DAILY_LOSS_PCT     → control riesgo automático
#  + Filtro volumen         → solo monedas con liquidez real
#  + TP3_ATR_MULT=7.0       → más margen para el runner
#  + XAUT-USDT              → oro tokenizado 24/7 por API
#
# ════════════════════════════════════════════════
